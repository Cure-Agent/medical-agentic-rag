# 스크래치 DB (prod 코퍼스 덤프) — cure-agent-be compose postgres의 hybrid_probe
DATABASE_URL=postgresql://cure:cure@localhost:5432/hybrid_probe

OPENAI_API_KEY=sk-...

# 추적 — 실호출 스크립트(scripts/smoke_llm.py · evals/run_routing.py · evals/run_synthesis.py)만
# 이 파일에서 읽는다. 비우면 추적 없이 돈다.
# 에이전트 서비스(app/service)는 .env를 읽지 않는다 — BE_ORIGIN·AGENT_TRACING_ENABLED·
# OPENAI_API_KEY를 프로세스 환경변수로만 받는다(app/service/config.py).
LANGSMITH_API_KEY=

# 코퍼스 임베딩과 반드시 같은 모델이어야 한다 (좌표계가 다르면 코사인 거리가 무의미)
EMBEDDING_MODEL=text-embedding-3-small

# init_chat_model 형식: "provider:model"
AGENT_MODEL=openai:gpt-5.4-mini

# 검색 정책 — cure-agent-be 운영값에서 가져옴
ARM_K=30
TOP_K=5
DISTANCE_CUTOFF=0.48

# 에이전트 루프 예산
MAX_RETRIEVAL=2
